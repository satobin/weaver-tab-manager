{
  "name": "weaver-tab-manager",
  "version": "1.0.4",
  "private": true,
  "author": "Simon Tobin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/satobin/weaver-tab-manager.git"
  },
  "bugs": {
    "url": "https://github.com/satobin/weaver-tab-manager/issues"
  },
  "homepage": "https://github.com/satobin/weaver-tab-manager#readme",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm run dev:test",
    "dev:test": "vite --mode test",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc --noEmit && vite build",
    "build:chrome": "pnpm run build",
    "build:edge": "pnpm run clean && tsc --noEmit && vite build --mode edge",
    "build:test": "tsc --noEmit && vite build --mode test",
    "test:extension-id": "node scripts/build-test-extension.mjs --show-extension-id",
    "package:test": "pnpm run check && node scripts/build-test-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "zip:chrome": "node scripts/build-release.mjs --target=chrome",
    "zip:dist": "pnpm run zip:chrome",
    "zip:edge": "node scripts/build-release.mjs --target=edge",
    "package:preview:chrome": "pnpm run build:chrome && node scripts/build-release.mjs --target=chrome --preview",
    "package:preview:edge": "pnpm run build:edge && node scripts/build-release.mjs --target=edge --preview",
    "release:chrome": "pnpm run validate && pnpm run zip:chrome",
    "release:webstore": "pnpm run release:chrome",
    "release:edge": "pnpm run check && pnpm run clean && vite build --mode edge && pnpm run zip:edge",
    "validate": "pnpm run check && pnpm run clean && vite build"
  },
  "dependencies": {
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.2.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.5.2",
    "adm-zip": "0.6.0",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
